{
  "expo": {
    "name": "Fitli",
    "slug": "fitli-app",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "fitli",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitli.personal",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.fitli.personal",
      "adaptiveIcon": {
        "backgroundColor": "#0E0B1A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fitli uses your location to find coffee carts and cafés along your next running route."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Fitli",
      "themeColor": "#0E0B1A",
      "backgroundColor": "#0E0B1A"
    },
    "backgroundColor": "#0E0B1A"
  }
}